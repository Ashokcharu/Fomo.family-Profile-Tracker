# Core app
APP_ENV=development
APP_NAME=multichain-token-intelligence
PROJECT_NAME=multichain-token-intelligence
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://localhost:6379/0

# Provider settings
FOMO_FAMILY_API_URL=https://api.fomo.family
DEXSCREENER_API_URL=https://api.dexscreener.com
HELIUS_API_KEYS=your_key_1,your_key_2
HELIUS_KEY_ROTATION_ENABLED=true
HELIUS_REQUEST_TIMEOUT_SECONDS=20
HELIUS_MAX_RETRIES=5

# Feature defaults
TOKEN_REFRESH_INTERVAL_SECONDS=300
DISCOVERY_THRESHOLD_USD=50000
DISCOVERY_PREFERRED_MIN_USD=10000
DISCOVERY_PREFERRED_MAX_USD=30000
GRADUATION_THRESHOLD_USD=50000
MINIMUM_UNIQUE_BUYERS=2
BUY_CLUSTER_WINDOW_SECONDS=900
MINIMUM_LIQUIDITY_USD=5000
HIGH_PRIORITY_DATA_FRESHNESS_SECONDS=60

# Local Ollama AI discovery
AI_DISCOVERY_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Fomo Family browser monitor
FOMO_ACTIVITY_MONITOR_ENABLED=true
FOMO_ACTIVITY_BROWSER_PROFILE_DIR=~/.cache/fomo-following

# Timeouts and backoff
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
MAX_CONCURRENT_JOBS=10
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=200

# Add your real keys here when ready:
# HELIUS_API_KEYS=your_live_key_one,your_live_key_two
